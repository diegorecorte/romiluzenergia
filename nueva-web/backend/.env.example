# No poner valores reales en GitHub. El servidor lee el entorno, no carga este archivo automáticamente.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
ROMILUZ_PRIVATE_ROOT=/data/romiluz
ROMILUZ_SITE_PUBLIC=0
ROMILUZ_PRIVACY_READY=0
ROMILUZ_CANONICAL_ORIGIN=https://www.romiluzenergiarenovable.com
# SMTP: configurar remitente verificado. No se adjuntan facturas a los avisos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
ROMILUZ_LEADS_EMAIL=romiluzenergiarenovable@gmail.com
# Dejar vacío hasta disponer de clamscan actualizado y operativo.
ROMILUZ_INVOICE_SCANNER=
# Solo con proxy controlado que sobrescriba X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
# Sincronización de reseñas: cuenta/ubicación verificada y OAuth business.manage.
GOOGLE_BUSINESS_LOCATION=
GOOGLE_BUSINESS_ACCESS_TOKEN=
# Para renovación sin intervención, en lugar del token temporal:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
